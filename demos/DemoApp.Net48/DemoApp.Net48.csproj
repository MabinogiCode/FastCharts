<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(OS)'=='Windows_NT'">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <!-- Non-Windows: Windows-only demo, build an empty placeholder so the solution builds.
       Default items are disabled at evaluation time; removing Compile items in a target
       (previous approach) ran after compilation and the build still failed. -->
  <PropertyGroup Condition="'$(OS)'!='Windows_NT'">
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <Target Name="SkipBuildNonWindows" BeforeTargets="Build" Condition="'$(OS)'!='Windows_NT'">
    <Message Text="Skipping DemoApp.Net48 (Windows-only demo) build on non-Windows host." Importance="High" />
  </Target>
  <ItemGroup Condition="'$(OS)'=='Windows_NT'">
    <ProjectReference Include="..\..\src\FastCharts.Wpf\FastCharts.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)'=='Windows_NT'">
    <!-- Updated to match FastCharts.Wpf dependency to avoid NU1605 downgrade warning -->
    <PackageReference Include="DynamicData" Version="9.4.1" />
    <!-- StyleCop Analyzers for strict SA1124 enforcement -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="all" IncludeAssets="analyzers" />
    <!-- P1-EXPORT-PNG: Add System.Drawing for clipboard support in .NET Framework -->
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>